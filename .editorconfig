[*]
charset = utf-8


[*.cs]

# SYSLIB1045: Convert to 'GeneratedRegexAttribute'.
dotnet_diagnostic.SYSLIB1045.severity = silent

# IDE0290: Use primary constructor
dotnet_diagnostic.IDE0290.severity = silent

# IDE0009: Member access should be qualified.
dotnet_diagnostic.IDE0009.severity = silent

# IDE0021: Use expression body for constructor
dotnet_diagnostic.IDE0021.severity = silent

# IDE0046: Convert to conditional expression
dotnet_diagnostic.IDE0046.severity = silent

# IDE0045: Convert to conditional expression
dotnet_diagnostic.IDE0045.severity = silent

# IDE2005: Blank line not allowed after conditional expression token
dotnet_diagnostic.IDE2005.severity = silent

# IDE2006: Blank line not allowed after arrow expression clause token
dotnet_diagnostic.IDE2006.severity = silent

# IDE0018: Inline variable declaration
dotnet_diagnostic.IDE0018.severity = silent
