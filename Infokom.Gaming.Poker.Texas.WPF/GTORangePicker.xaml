<Window x:Class="Infokom.Gaming.Poker.Texas.WPF.GTORangePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	   xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Infokom.Gaming.Poker.Texas.WPF"
        xmlns:controls="clr-namespace:Infokom.Gaming.Poker.Texas.WPF.Controls"
        xmlns:models="clr-namespace:Infokom.Gaming.Poker.Texas.WPF.Models"
        mc:Ignorable="d"
        Title="GTO Range Picker" SizeToContent="WidthAndHeight" ResizeMode="NoResize" >

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

				<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	
	<Window.DataContext>
		<models:GTORangePickerModel></models:GTORangePickerModel>
	</Window.DataContext>

	<DockPanel LastChildFill="True">
		<UniformGrid DockPanel.Dock="Top" Columns="2">
			<DockPanel LastChildFill="True" Margin="10">
				<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
					<ComboBox materialDesign:HintAssist.Hint="Opponents" 
						ItemsSource="{Binding EstimatorRivalsCountOptions}" 
						SelectedValue="{Binding EstimatorRivalsCount}"/>

					<Button Margin="3" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding EstimateCommand}">
						<materialDesign:PackIcon Kind="Reload"/>
					</Button>

					<!--<Button Margin="3" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding ExecuteCommand}">
						<materialDesign:PackIcon Kind="Reload"/>
					</Button>-->
				</StackPanel>
				<ProgressBar x:Name="EstimatorProgressBar" Value="{Binding EstimatorProgress, Mode=OneWay}" IsIndeterminate="False"  Minimum="0" Maximum="169"/>
				<!--<ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="False"  Minimum="0" Maximum="169"/>-->

			</DockPanel>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="BtnSave" Margin="10" Style="{StaticResource MaterialDesignFlatButton}" Content="{materialDesign:PackIcon Kind=Floppy}"/>
			</StackPanel>
		</UniformGrid>

		<DockPanel DockPanel.Dock="Bottom" LastChildFill="True">
			<TextBlock DockPanel.Dock="Right" Margin="5" TextAlignment="Right" FontSize="16" FontWeight="Bold" Width="96" Text="{Binding SelectedCellsFraction, Mode=OneWay, StringFormat={}{0:00.00%}}"/>
			<Slider Margin="5" VerticalAlignment="Center" Minimum="0" Maximum="169"  Value="{Binding SelectedCellsCount}"/>
		</DockPanel>

		<controls:GTORangeMatrix DockPanel.Dock="Top" Margin="5" DataContext="{Binding Matrix}"/>

	</DockPanel>
</Window>
 