<Window x:Class="Infokom.Numerics.WPF.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Infokom.Numerics.WPF.Demo"
	   xmlns:appModels="clr-namespace:Infokom.Numerics.WPF.Demo.Models"
        mc:Ignorable="d"
        Title="INFOKOM - Numerics Demo" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
	<DockPanel LastChildFill="True">
		<DockPanel.DataContext>
			<appModels:NormalDistributionHeatmapModel/>
		</DockPanel.DataContext>

		<DockPanel DockPanel.Dock="Left" LastChildFill="True">
			<Image DockPanel.Dock="Top" Width="240" Margin="5" Source="{Binding Formula}"></Image>
			<UniformGrid Columns="2"></UniformGrid>
		</DockPanel>

		<Image Width="640" Height="480" Source="{Binding Heatmap}"></Image>
	</DockPanel>
</Window>
